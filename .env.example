# Copy to .env and set STRONG values. .env is gitignored -- never commit real secrets.
# After setting these, run scripts/setup_mqtt_auth.sh (writes mosquitto.passwd) and, on an
# existing Mongo volume, scripts/setup_mongo_auth.sh (creates the root user once).
MONGO_USER=iotsensing
MONGO_PASS=change-me-please
MQTT_USER=iotsensing
MQTT_PASS=change-me-please
